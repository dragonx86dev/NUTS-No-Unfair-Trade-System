<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <AssemblyName>nuts</AssemblyName>
        <Version>1.5.0</Version>

        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <OutputType>Library</OutputType>

        <ClientTfm>netstandard2.1</ClientTfm>
        <ServerTfm>net10.0</ServerTfm>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NutsClient\NutsClient.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\NutsServer\NutsServer.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="RemoveDirectories" BeforeTargets="BeforeBuild">
        <RemoveDir Directories="./bin/;./build/;./dist/" />
    </Target>

    <Target Name="CopyCustomContent" AfterTargets="AfterBuild">

        <!-- ============ NutsClient → BepInEx/plugins ============ -->
        <ItemGroup>
            <ClientDll Include="..\NutsClient\bin\$(Configuration)\$(ClientTfm)\nuts.dll" />
            <ClientData Include="..\NutsClient\bin\$(Configuration)\$(ClientTfm)\data\**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(ClientDll)"
              DestinationFolder="./build/BepInEx/plugins/NutsClient/" />

        <Copy SourceFiles="@(ClientData)"
              DestinationFolder="./build/BepInEx/plugins/NutsClient/data/%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition="'@(ClientData)' != ''" />

        <!-- ============ NutsServer → SPT_Runtime/user/mods ============ -->
        <ItemGroup>
            <ServerDll  Include="..\NutsServer\bin\$(Configuration)\$(ServerTfm)\nuts.dll" />
            <ServerData Include="..\NutsServer\bin\$(Configuration)\$(ServerTfm)\data\**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(ServerDll)"
              DestinationFolder="./build/SPT_Runtime/user/mods/NutsServer/" />

        <Copy SourceFiles="@(ServerData)"
              DestinationFolder="./build/SPT_Runtime/user/mods/NutsServer/data/%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition="'@(ServerData)' != ''" />
    </Target>

    <Target Name="ZipOutputPath" AfterTargets="Build">
        <MakeDir Directories="./dist" Condition="!Exists('./dist')" />
        <Delete Files="./dist/$(AssemblyName)-$(Version).zip"
                Condition="Exists('./dist/$(AssemblyName)-$(Version).zip')" />
        <ZipDirectory SourceDirectory="./build"
                      DestinationFile="./dist/$(AssemblyName)-$(Version).zip" />
    </Target>

</Project>